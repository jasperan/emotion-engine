# EmotionSim Backend Environment Variables
# Copy this file to .env and configure as needed

# Application
APP_NAME=EmotionSim
DEBUG=false

# Database (Oracle DB 26ai Free)
ORACLE_DB_HOST=localhost
ORACLE_DB_PORT=1522
ORACLE_DB_SERVICE=FREEPDB1
ORACLE_DB_USER=emotionsim
ORACLE_DB_PASSWORD=emotionsim

# Datalake (analytics tables in same Oracle instance)
DATALAKE_ENABLED=true

# LLM Backend (vllm or ollama)
# vLLM is default for bare-metal; Docker defaults to ollama
LLM_BACKEND=vllm

# vLLM
VLLM_BASE_URL=http://localhost:8010
VLLM_DEFAULT_MODEL=Qwen/Qwen3.5-4B

# Ollama (fallback)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_DEFAULT_MODEL=qwen3.5:4b
OLLAMA_FALLBACK_MODEL=qwen3.5:4b

# Docker Compose LLM overrides
# These are intentionally separate from the host settings above because
# localhost inside the backend container is not the host machine.
DOCKER_LLM_BACKEND=ollama
DOCKER_VLLM_BASE_URL=http://host.docker.internal:8010
DOCKER_VLLM_DEFAULT_MODEL=Qwen/Qwen3.5-4B
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
DOCKER_OLLAMA_API_KEY=ollama
DOCKER_OLLAMA_DEFAULT_MODEL=qwen3.5:4b
DOCKER_OLLAMA_FALLBACK_MODEL=qwen3.5:4b

# Claude/Anthropic (optional, for future use)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-sonnet-20240229

# Simulation defaults
DEFAULT_MAX_STEPS=10
DEFAULT_TICK_DELAY=0.5

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
