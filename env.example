# EmotionSim Backend Environment Variables
# Copy this file to .env and configure as needed

# Application
APP_NAME=EmotionSim
DEBUG=false

# Database (Oracle DB 26ai Free, primary; SQLite fallback for dev/pi)
ORACLE_DB_HOST=localhost
ORACLE_DB_PORT=1522
ORACLE_DB_SERVICE=FREEPDB1
ORACLE_DB_USER=emotionsim
ORACLE_DB_PASSWORD=emotionsim
ORACLE_PASSWORD=oracle
# auto = probe Oracle (real credential check) → SQLite file fallback
# oracle_forced = require Oracle (raises if unreachable)
DATABASE_BACKEND=auto
SQLITE_DB_PATH=emotionsim_runtime.db
# Docker Compose bind IP for the installer. Use 0.0.0.0 only when LAN exposure is intended.
COMPOSE_BIND_ADDR=127.0.0.1

# Datalake (analytics tables in same Oracle instance)
DATALAKE_ENABLED=true

# LLM Backend (auto | vllm | ollama | openai | stub)
# auto probes vLLM → Ollama → offline stub and picks the first that responds,
# so the same code runs on a GPU box, a laptop, or a container.
LLM_BACKEND=auto

# vLLM
VLLM_BASE_URL=http://localhost:8010
VLLM_DEFAULT_MODEL=Qwen/Qwen3.5-4B

# Ollama (fallback)

# Cost accounting for observability (run metrics: cost_estimate_usd)
LLM_COST_PER_1K_TOKENS=0.0

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_DEFAULT_MODEL=qwen3.5:4b
OLLAMA_FALLBACK_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=300           # seconds per request (long prompts + cold GPU TTFT)
OLLAMA_KEEP_ALIVE=30m        # how long models stay loaded in VRAM between ticks

# Docker Compose LLM overrides
# These are intentionally separate from the host settings above because
# localhost inside the backend container is not the host machine.
DOCKER_LLM_BACKEND=ollama
DOCKER_VLLM_BASE_URL=http://host.docker.internal:8010
DOCKER_VLLM_DEFAULT_MODEL=Qwen/Qwen3.5-4B
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
DOCKER_OLLAMA_API_KEY=ollama
DOCKER_OLLAMA_DEFAULT_MODEL=qwen3.5:4b
DOCKER_OLLAMA_FALLBACK_MODEL=qwen3.5:4b

# Claude/Anthropic (optional, for future use)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-sonnet-20240229

# Simulation defaults
DEFAULT_MAX_STEPS=10
DEFAULT_TICK_DELAY=0.5
# Seconds before a tick is considered failed. Generous default for cold GPU
# warm-up (Ollama model load + first-token latency can exceed 2 minutes).
AGENT_TICK_TIMEOUT=240

# Hybrid populations (LightweightAgent scaling)
# Background agents (scenario templates with "background": true) make rule-based
# decisions with zero LLM calls; they are promoted to full LLM agents when
# addressed directly, in an active scene, or high-leadership with low stress.
MAX_LLM_AGENTS_PER_STEP=0        # 0 = unlimited; N = at most N agents call the LLM per step
BACKGROUND_DEMOTE_AFTER_STEPS=5  # foreground steps without activity before demotion

# Cognitive reflection: every N steps, foreground agents run a batched LLM
# reflection that distills lessons into episodic memory.
REFLECTION_INTERVAL_STEPS=5

# Governance gates + goal tree (wired into the V1 engine)
GOVERNANCE_ENABLED=true
GOVERNANCE_USE_LLM_SCORER=false   # true = LLM reviews flagged actions; false = keyword classifier
GOVERNANCE_THRESHOLD=0.7
GOAL_TREE_ENABLED=true

# Graph-backed agent memory (MiroFish)
# true = HumanAgents recall via hybrid graph search (relevance, not recency)
# Requires an Oracle knowledge graph per run (created automatically); falls
# back to flat memory gracefully if the graph layer is unavailable.
GRAPH_MEMORY_ENABLED=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Deferred brainstorm ideas (all opt-in; off keeps byte-identical behavior) ──

# Semantic LLM response caching: repeated/near-identical prompts skip the LLM.
LLM_CACHE_ENABLED=false
LLM_CACHE_THRESHOLD=0.95         # cosine similarity for a cache hit
LLM_CACHE_MAX_ENTRIES=1024
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_EMBEDDING=auto         # auto = Ollama nomic-embed-text, else offline n-gram

# Emotion valence/arousal dimensions: personality baselines + event/LLM-driven
EMOTION_DIMENSIONS_ENABLED=false
EMOTION_DECAY=0.3                # per-tick relaxation toward baseline
EMOTION_LM_PULL=0.5              # how strongly the LLM's emotion word moves the state

# Message distortion / rumor spread: retold stories lose fidelity per hop
RUMOR_DISTORTION_ENABLED=false
RUMOR_FIDELITY_DROP=0.15         # per-hop fidelity loss
RUMOR_OVERLAP_THRESHOLD=0.5      # token Jaccard to count as a relay

# Dynamic agent spawning / departure (evacuees arrive, exhausted agents leave)
DYNAMIC_SPAWNING_ENABLED=false
SPAWN_INTERVAL_STEPS=3
SPAWN_MAX_EXTRA_AGENTS=5
SPAWN_LOCATION=shelter
SPAWN_EVICT_HEALTH_THRESHOLD=1
SPAWN_EVICT_STRESS_THRESHOLD=9

# Theory of Mind: agents infer peers' goals/states/intentions from actions
THEORY_OF_MIND_ENABLED=false

# Optional multi-tenant API auth (users + API keys). Callers without a key
# keep anonymous access to public data (CLI/TUI/eval unaffected).
AUTH_ENABLED=true
